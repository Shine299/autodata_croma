CROMA_API_KEY=
CROMA_BASE_URL=https://api.croma.run
# mock = lee fixtures/ (dev y tests) | live = consume la API real de Croma (competencia)
CROMA_MODE=live
CROMA_TIMEOUT_SECONDS=40

TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling

SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# IA de fraseo (opcional). Key gratuita de Google AI Studio (aistudio.google.com).
# Si se deja vacía, el bot funciona igual con su texto determinista (fallback).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
LLM_ENABLED=true

APP_ENV=dev
PUBLIC_BASE_URL=http://localhost:8080
INTERNAL_API_KEY=
